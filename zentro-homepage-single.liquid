<script>
(function(){
  var root = document.currentScript ? document.currentScript.closest('.shopify-section') : document;
  function q(s){ return (root||document).querySelectorAll(s); }
  // Scroll reveal
  var io = new IntersectionObserver(function(entries){
    entries.forEach(function(e){ if(e.isIntersecting){ e.target.classList.add('in'); io.unobserve(e.target); } });
  }, { threshold: 0.12 });
  q('.reveal, .reveal-left, .reveal-right, .reveal-scale, .stagger').forEach(function(el){ io.observe(el); });

  // Parallax printer
  var stage = (root||document).querySelector('.stage');
  window.addEventListener('scroll', function(){ if(stage){ stage.style.transform='translateY('+(window.scrollY*0.04)+'px)'; } }, {passive:true});

  // Count-up stats
  var seen=false;
  var statsSection=(root||document).querySelector('.stats');
  if(statsSection){
    var so=new IntersectionObserver(function(entries){
      entries.forEach(function(e){
        if(e.isIntersecting && !seen){ seen=true;
          q('.stat-num').forEach(function(el){
            var t=parseInt(el.getAttribute('data-target'),10)||0, sfx=el.getAttribute('data-suffix')||'', dur=1600, st=null;
            function step(ts){ if(!st)st=ts; var p=Math.min((ts-st)/dur,1); var ea=1-Math.pow(1-p,3); el.textContent=Math.floor(ea*t)+sfx; if(p<1)requestAnimationFrame(step); else el.textContent=t+sfx; }
            requestAnimationFrame(step);
          });
        }
      });
    }, {threshold:0.4});
    so.observe(statsSection);
  }

  // Hero slider
  var track=(root||document).querySelector('#hsTrack');
  if(track){
    var slides=track.querySelectorAll('.hs-slide');
    var dotsWrap=(root||document).querySelector('#hsDots');
    var cur=0, timer=null, interval=(parseInt('{{ section.settings.slide_seconds }}',10)||3)*1000;
    if(slides.length>0){
      for(var i=0;i<slides.length;i++){ var d=document.createElement('button'); d.className='hs-dot'+(i===0?' active':''); d.setAttribute('data-i',i); d.addEventListener('click',function(e){e.preventDefault();go(parseInt(e.currentTarget.getAttribute('data-i'),10));restart();}); dotsWrap.appendChild(d); }
      var dots=dotsWrap.querySelectorAll('.hs-dot');
      function go(i){ cur=(i+slides.length)%slides.length; track.style.transform='translateX(-'+(cur*100)+'%)'; dots.forEach(function(dot,idx){dot.classList.toggle('active',idx===cur);}); }
      function next(){go(cur+1);} function prev(){go(cur-1);}
      var nb=(root||document).querySelector('#hsNext'), pb=(root||document).querySelector('#hsPrev');
      if(nb)nb.addEventListener('click',function(e){e.preventDefault();next();restart();});
      if(pb)pb.addEventListener('click',function(e){e.preventDefault();prev();restart();});
      function startAuto(){ if(slides.length>1 && !timer){ timer=setInterval(next,interval); } }
      function stopAuto(){ if(timer){ clearInterval(timer); timer=null; } }
      function restart(){ stopAuto(); startAuto(); }
      // Kick off auto-advance immediately from slide 1
      startAuto();
      var el=(root||document).querySelector('#heroSlider');
      if(el){
        el.addEventListener('mouseenter',stopAuto);
        el.addEventListener('mouseleave',startAuto);
        var sx=0; el.addEventListener('touchstart',function(e){sx=e.touches[0].clientX;},{passive:true});
        el.addEventListener('touchend',function(e){var dx=e.changedTouches[0].clientX-sx; if(dx<-40){next();restart();} else if(dx>40){prev();restart();}},{passive:true});
      }
    }
  }
})();
</script>


{% schema %}
{
  "name": "Zentro Homepage",
  "settings": [
    {
      "type": "header",
      "content": "Brand"
    },
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand name",
      "default": "ZENTRO WORKS"
    },
    {
      "type": "text",
      "id": "slogan",
      "label": "Slogan",
      "default": "Beyond the Ordinary"
    },
    {
      "type": "header",
      "content": "Hero Slider"
    },
    {
      "type": "range",
      "id": "slide_seconds",
      "label": "Seconds per slide",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 3
    },
    {
      "type": "header",
      "content": "Best Sellers"
    },
    {
      "type": "collection",
      "id": "bestseller_collection",
      "label": "Best sellers collection"
    },
    {
      "type": "header",
      "content": "Contact"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Phone",
      "default": "+91 93422 33076"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Email",
      "default": "sales@zentroworks.com"
    },
    {
